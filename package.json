{
  "name": "aicte-fdr-portal",
  "version": "1.0.0",
  "description": "AICTE Security Deposit / FDR Management Portal - Monorepo with Zero Trust Architecture",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client"
  },
  "keywords": [
    "aicte",
    "fdr-management",
    "zero-trust",
    "react",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC"
}
